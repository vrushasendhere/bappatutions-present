{
  "name": "bappatutions-present",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run export:build && astro dev",
    "build": "npm run export:build && astro build && node scripts/write-assetsignore.mjs",
    "export:build": "node scripts/build-export-player.mjs",
    "preview": "npm run build && wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bappatutions-present --local",
    "db:migrate:remote": "wrangler d1 migrations apply bappatutions-present --remote",
    "db:seed:local": "wrangler d1 execute bappatutions-present --local --file=./seed/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^5.2.0",
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/preact": "^4.0.0",
    "preact": "^10.24.0",
    "drizzle-orm": "^0.36.0",
    "nanoid": "^5.0.7",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@astrojs/check": "^0.9.0",
    "esbuild": "^0.27.7"
  }
}
